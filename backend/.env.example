PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/swasthone
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret

# Production settings
# Comma-separated browser origins allowed to call this API (e.g. your frontend URL)
CORS_ORIGINS=http://localhost:5173
# Public URL of the rPPG service (added to the CSP connect-src)
RPPG_URL=http://localhost:8000
# Optional: reverse-proxy non-API requests to a hosted frontend
# FRONTEND_URL=https://your-frontend.example.com
# Demo accounts are blocked in production unless this is "true"
# ALLOW_DEMO_SEED=false
